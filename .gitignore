# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.test
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
prisma/dev.*

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.playwright-mcp/
/logs/
/blog/
diff.txt
data/*

# Local agent/browser settings and root screenshot captures
/.claude/settings.local.json
/*-mobile-*.png

/dist
scripts/test-outlook-task-api.sh

# local-only files (infra, scripts, etc. - never commit)
/local/

# git worktrees created by skills (e.g. implement-github-issue)
/.claude/worktrees/

# Figma Make leftovers, archived 2026-08-31 — delete once confirmed
_archive-figma-make/

# 205TF Exposure trial fonts — testing only, no commercial use, never commit
design-refs/fonts/

# The Claude Design bundle ships the Exposure trial font inside it.
# Track the bundle, never the font — same trial licence as design-refs/fonts/.
needt-app-design/**/*.woff2
Needt Design System/**/*.woff2

# A Claude Design export carries its own working material: the images the
# board was assembled from, and its screenshots. Measured 6 Oct 2026, that is
# 193 MB of a 197 MB bundle — the design itself is about 4 MB. Track the
# design, never the working material.
Content height and label fixes/uploads/
Content height and label fixes/screenshots/
Content height and label fixes/**/*.woff2
Needt - Design : App, Landing/uploads/
Needt - Design : App, Landing/screenshots/
Needt - Design : App, Landing/**/*.woff2
