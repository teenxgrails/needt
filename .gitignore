# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.test
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
prisma/dev.*

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.playwright-mcp/
/logs/
/blog/
diff.txt
data/*

# Local agent/browser settings and root screenshot captures
/.claude/settings.local.json
/*-mobile-*.png

/dist
scripts/test-outlook-task-api.sh

# local-only files (infra, scripts, etc. - never commit)
/local/

# git worktrees created by skills (e.g. implement-github-issue)
/.claude/worktrees/

# Figma Make leftovers, archived 2026-08-31 — delete once confirmed
_archive-figma-make/

# 205TF Exposure trial fonts — testing only, no commercial use, never commit
design-refs/fonts/

# The Claude Design bundle ships the Exposure trial font inside it.
# Track the bundle, never the font — same trial licence as design-refs/fonts/.
needt-app-design/**/*.woff2
Needt Design System/**/*.woff2

# Skills: the project's own live in .claude/skills and are tracked; everything
# else there is a personal or third-party set that belongs to the machine.
.claude/skills/*
!.claude/skills/banner-design/
!.claude/skills/brand/
!.claude/skills/design/
!.claude/skills/design-system/
!.claude/skills/hallmark/
!.claude/skills/needt-critique/
!.claude/skills/slides/
!.claude/skills/ui-styling/
!.claude/skills/ui-ux-pro-max/
!.claude/skills/implement-github-issue/
!.claude/skills/openspec-apply-change/
!.claude/skills/openspec-archive-change/
!.claude/skills/openspec-explore/
!.claude/skills/openspec-propose/
!.claude/skills/review-merge-port-pr/
