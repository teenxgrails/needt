# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.test
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
prisma/dev.*

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/logs/
/blog/
diff.txt
data/*

/dist
scripts/test-outlook-task-api.sh

# local-only files (infra, scripts, etc. - never commit)
/local/

# git worktrees created by skills (e.g. implement-github-issue)
/.claude/worktrees/

# Figma Make leftovers, archived 2026-08-31 — delete once confirmed
_archive-figma-make/

# 205TF Exposure trial fonts — testing only, no commercial use, never commit
design-refs/fonts/

# The Claude Design bundle ships the Exposure trial font inside it.
# Track the bundle, never the font — same trial licence as design-refs/fonts/.
needt-app-design/**/*.woff2
Needt Design System/**/*.woff2
