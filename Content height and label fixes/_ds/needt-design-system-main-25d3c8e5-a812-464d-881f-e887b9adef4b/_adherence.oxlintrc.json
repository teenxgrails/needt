{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "components/calendar/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/surfaces/**",
              "ui_kits/needt-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Instrument Serif|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, Instrument Serif, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|name|src|size|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: initials, name, src, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|iconLeft|iconRight|loading|disabled|fullWidth|type|onClick|className|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, iconLeft, iconRight, loading, disabled, fullWidth, type, onClick, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neutral|outline|ghost|accent|destructive)$/]",
        "message": "<Button> variant must be one of 'neutral' | 'outline' | 'ghost' | 'accent' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalendarBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|time|movable|color|priority|compact|overdue|done|selected|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CalendarBlock> doesn't accept that prop. Declared props: title, time, movable, color, priority, compact, overdue, done, selected, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalendarBlock'] > JSXAttribute[name.name='priority'] > Literal[value!=/^(?:normal|high)$/]",
        "message": "<CalendarBlock> priority must be one of 'normal' | 'high'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalendarDay'] > JSXAttribute > JSXIdentifier[name!=/^(?:weekday|date|today|selected|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CalendarDay> doesn't accept that prop. Declared props: weekday, date, today, selected, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalendarStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<CalendarStrip> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|count|action|children|padding|selected|interactive|onClick|className|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, count, action, children, padding, selected, interactive, onClick, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|indeterminate|label|meta|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, indeterminate, label, meta, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|iconLeft|disabled|onClick|onRemove|className|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, tone, iconLeft, disabled, onClick, onRemove, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|success|info|destructive)$/]",
        "message": "<Chip> tone must be one of 'neutral' | 'accent' | 'success' | 'info' | 'destructive'."
